<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:padding="20dp">

    <!-- Form Alamat / Pesanan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat Pengiriman"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="16dp"/>

        <!-- Input Nama Lengkap -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_card_menu"
            android:hint="Nama Lengkap"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"/>

        <!-- Input Alamat -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_card_menu"
            android:hint="Alamat"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"/>

        <!-- Input Catatan -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/bg_card_menu"
            android:hint="Patokan atau detail lengkap"
            android:padding="16dp"
            android:gravity="top"
            android:layout_marginBottom="24dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"/>

        <!-- Tombol Order dan Kirim dengan ID btnSubmit -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Order dan Kirim"
            android:textColor="@color/white"
            android:backgroundTint="#1F1F1F"
            android:textStyle="bold"
            android:textAllCaps="false"/>

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="Home"
            android:textColor="@color/accent_peach"
            android:backgroundTint="@color/text_dark"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/navOrder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="Order"
            android:textColor="@color/accent_peach"
            android:backgroundTint="@color/text_dark"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="Profile"
            android:textColor="@color/accent_peach"
            android:backgroundTint="@color/text_dark"
            android:textStyle="bold"
            android:textAllCaps="false"/>

    </LinearLayout>

</RelativeLayout>